{
  "name": "ten-trener",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && vite build --config vite.web.config.ts",
    "start": "npm run preview",
    "test": "npm run build && npm run test:regression",
    "audit:careers": "node scripts/full-career-audit.mjs",
    "audit:matches": "node scripts/match-engine-audit.mjs",
    "audit:plans": "node scripts/team-plan-audit.mjs",
    "audit:events": "node scripts/event-diversity-audit.mjs",
    "audit:world": "node scripts/world-audit.mjs",
    "audit:tiers": "node --import ./scripts/ts-loader.mjs scripts/playable-career-audit.mjs",
    "import:regional": "node scripts/import-regional-catalog.mjs",
    "lint": "eslint app src lib tests --ignore-pattern dist",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "audit:playable": "node --import ./scripts/ts-loader.mjs scripts/playable-career-audit.mjs",
    "test:regression": "node --import ./scripts/ts-loader.mjs --test tests/*.test.mjs",
    "preview": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "build:sites": "bash scripts/build-verified.sh",
    "dev:sites": "vite --config vite.config.ts",
    "audit:release": "node --import ./scripts/ts-loader.mjs scripts/playable-career-audit.mjs",
    "test:http": "node scripts/smoke-web.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "description": "TEN TRENER \u2014 Pre-Alpha. Kariera trenera w realiach polskiej pi\u0142ki."
}
